<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="styles/styles.css" />
  </head>
  <body>
    <div id="mainContainer">
      <nav class="navbar">
        <div>
          <p><i class="bi bi-brightness-low-fill"></i>Sunguide</p>
        </div>

        <div>
          <i class="bi bi-geo-alt-fill"></i>
          <button onclick="getLocation()" id="locationButton">
            Click to Find my city
          </button>
        </div>
      </nav>

      <div class="px-4 py-5 my-5 text-center">
        <i class="bi bi-sun" id="sun"></i>
        <h1>Centered hero</h1>
        
        <div class="col-lg-6 mx-auto">
            <p class="lead mb-4" id="welcomeMessage">Welcome to the Sunguide</p>
          <div id="contentContainer">
            
            <button type="button" class = "btn-span">
              <span id="uvIndex"><%= content1 %></span> UV Index
            </button>
            <button type="button" class = "btn-span">
              <span id="burnTime"><%= content2 %></span> to burn
            </button>
            <button type="button" class = "btn-span">
              <span id="spfRec"><%= content3 %></span> recommended SPF
            </button>
          </div>
        </div>
      </div>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="js/main.js"></script>
  </body>
</html>
